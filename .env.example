# Telegram Bot API Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# AI Provider Configuration (OpenAI or any OpenAI-compatible API)
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.3

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zynygram_db?schema=public

# Comma-separated list of Telegram User IDs who have administrative privileges
ADMIN_TELEGRAM_IDS=123456789,987654321

# Telegram Chat ID (group or channel) for Human Support Escalations
SUPPORT_GROUP_ID=-1001234567890

# Application Configuration
MAX_MESSAGE_LENGTH=4000
NODE_ENV=development
PORT=3000

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000

