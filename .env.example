# Telegram Bot API Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# AI Provider Configuration (Google Gemini / OpenAI compatible)
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.3

# PostgreSQL Database Connection URL (Railway PostgreSQL or local)
DATABASE_URL=postgresql://user:password@host:port/dbname?schema=public

# Comma-separated list of Telegram User IDs with administrative privileges
ADMIN_TELEGRAM_IDS=8191294446

# Telegram Chat ID (group or user) for Human Support Escalations
SUPPORT_GROUP_ID=8191294446

# Admin Web Panel Password (for accessing /admin)
ADMIN_PANEL_PASSWORD=zynygram2026

# Application Configuration
MAX_MESSAGE_LENGTH=4000
NODE_ENV=production
PORT=3000

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000
