# Telegram Bot API Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# AI Provider Configuration (Google Gemini / OpenAI compatible)
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.3

# PostgreSQL Database Connection URL (Railway PostgreSQL or local)
DATABASE_URL=postgresql://user:password@host:port/dbname?schema=public

# Comma-separated list of Telegram User IDs with administrative privileges
ADMIN_TELEGRAM_IDS=

# Telegram Chat ID (group or user) for Human Support Escalations
SUPPORT_GROUP_ID=

# Admin Web Panel Password (for accessing /admin)
# Required in production. Use a unique, high-entropy password (at least 16 characters).
ADMIN_PANEL_PASSWORD=
ADMIN_SESSION_TTL_MS=28800000

# Application Configuration
MAX_MESSAGE_LENGTH=4000
NODE_ENV=production
PORT=3000

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000
